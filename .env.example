JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# CLIENT_URL is a faithful carry-over of the original Express app's own
# fallback value -- it still points at the dead Vite dev port (5173), which
# this Next.js app never runs on. It feeds lib/email.js's password-reset and
# email-change link generation (see FRONTEND_URL below, which takes priority
# when set) and, separately, the original Express-only CORS `origin` config
# (server/server.js -- not used by the Next.js app itself, kept here only
# because server/ is retained as the parity oracle, see README.md). Set this
# to your real deployed frontend origin in every real environment; the
# localhost:5173 default is only correct for nothing in this app anymore.
CLIENT_URL=http://localhost:5173

# FRONTEND_URL -- lib/email.js:415 prefers this over CLIENT_URL when
# building password-reset and email-change confirmation links
# (`process.env.FRONTEND_URL || process.env.CLIENT_URL || 'http://localhost:5173'`).
# Undocumented before this fix wave. Set this to the real deployed frontend
# origin (e.g. https://shop.zahzan.com) so those emailed links resolve
# correctly instead of falling back to CLIENT_URL's stale localhost value.
FRONTEND_URL=your_deployed_frontend_url_here

SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_URL=your_supabase_db_connection_string_here
SUPABASE_STORAGE_BUCKET_PRODUCTS=product-images
SUPABASE_STORAGE_BUCKET_PROOFS=payment-proofs

# ZAHZAN_DB_DRIVER -- selects lib/db.js's data-access driver. Leave UNSET (or
# any value other than 'pglite') in every real environment: unset selects the
# production `pg` Pool against SUPABASE_DB_URL, which is what you want.
# 'pglite' selects @electric-sql/pglite, an in-process, in-memory WASM
# Postgres meant ONLY for local tests and the Task 15 parity-verification
# harness (tools/run-pglite-server.mjs) -- every row it holds lives in this
# one process's memory and is gone the instant the process exits. Never set
# ZAHZAN_DB_DRIVER=pglite in production: it would silently run the whole app
# against a database that resets to empty on every restart/redeploy, with no
# error and no warning.
ZAHZAN_DB_DRIVER=

# ZAHZAN_STORAGE_DRIVER -- selects lib/storage.js's payment-proof/product-
# image storage driver. Defaults to 'supabase' (real Supabase Storage,
# durable, what production needs) when unset. The only other value,
# 'memory', is an in-process fake used solely by local tests and the
# ZAHZAN_DB_DRIVER=pglite verification harness above. WARNING: if
# ZAHZAN_STORAGE_DRIVER=memory is ever set in production, every uploaded
# payment proof is written to a plain in-process Map instead of Supabase
# Storage and is PERMANENTLY LOST, silently (no error to the uploader, no
# error in logs) the moment the server process restarts or a new instance
# spins up -- this is customer payment evidence, not a cache. Leave this
# unset (or explicitly 'supabase') in every real environment.
ZAHZAN_STORAGE_DRIVER=

RESEND_API_KEY=your_resend_api_key_here

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email_user_here
EMAIL_PASSWORD=your_email_password_here
EMAIL_FROM="ZAHZAN Maison" <your_email_user_here>

# AI_API_KEY -- carried over from the original .env.example but read by
# NOTHING in this codebase (grepped app/, lib/, server/ -- zero references
# to process.env.AI_API_KEY anywhere). Kept here, unused, only because M2
# flagged it rather than silently dropping a variable someone may already
# have set in a real deployment's environment. Safe to remove if you don't
# already depend on it existing.
AI_API_KEY=your_ai_api_key_here

ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_admin_password_here

# Dropped after migration (no longer used):
# PORT=5000
# MONGODB_URI=mongodb://localhost:27017/zahzan_db
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
